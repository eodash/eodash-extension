{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eodash.github.io/eodash-extension/v0.2.0/schema.json#",
  "title": "Interactive Dashboards (eodash) Extension",
  "description": "STAC Interactive Dashboards (eodash) Extension for STAC Catalogs, STAC Collections and STAC Items.",
  "type": "object",
  "required": [
    "stac_extensions",
    "type"
  ],
  "properties": {
    "stac_extensions": {
      "type": "array",
      "contains": {
        "const": "https://eodash.github.io/eodash-extension/v0.2.0/schema.json"
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "Catalog",
        "Collection",
        "Feature"
      ]
    },
    "assets": {
      "$comment": "This validates the fields in Item and Collection Assets, but does not require them.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/assetAndLinkFields"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/assetAndLinkFields"
      }
    },
    "assetTemplates": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/assetAndLinkFields"
      }
    },
    "linkTemplates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/assetAndLinkFields"
      }
    }
  },
  "oneOf": [
    {
      "$comment": "This is the schema for STAC Items.",
      "type": "object",
      "required": [
        "type",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "properties": {
          "$ref": "#/definitions/topLevelFields"
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/noFields"
        }
      ]
    },
    {
      "$comment": "This is the schema for top-level fields and item assets in STAC Collections.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "Collection"
        },
        "item_assets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/assetAndLinkFields"
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/topLevelFields"
        }
      ]
    },
    {
      "$comment": "This is the schema for STAC Catalogs. Catalogs don't have top-level fields.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "Catalog"
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/noFields"
        }
      ]
    }
  ],
  "definitions": {
    "eodash:mapProjection": {
      "type": "object",
      "required": [
        "name",
        "def"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "def": {
          "type": "string",
          "minLength": 1
        },
        "extent": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "eodash:jsonform": {
      "type": "string",
      "format": "uri"
    },
    "eodash:rasterform": {
      "type": "string",
      "format": "uri"
    },
    "eodash:vegadefinition": {
      "type": "string",
      "format": "uri"
    },
    "eodash:colorlegend": {
      "type": "object",
      "required": [
        "domain",
        "range"
      ],
      "properties": {
        "domain": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "range": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scaleType": {
          "type": "string",
          "enum": [
            "linear",
            "log",
            "pow",
            "sqrt",
            "symlog",
            "continuous",
            "discrete"
          ]
        },
        "title": {
          "type": "string"
        },
        "tickFormat": {
          "type": [
            "string",
            "object"
          ]
        },
        "width": {
          "type": "number"
        },
        "ticks": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          ]
        },
        "tickValues": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "markType": {
          "type": "string"
        }
      }
    },
    "eodash:flatstyle": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "object"
        }
      ]
    },
    "topLevelFields": {
      "$comment": "Fields allowed at the top-level of Collections and in Item properties.",
      "type": "object",
      "properties": {
        "eodash:mapProjection": {
          "$ref": "#/definitions/eodash:mapProjection"
        },
        "eodash:jsonform": {
          "$ref": "#/definitions/eodash:jsonform"
        },
        "eodash:rasterform": {
          "$ref": "#/definitions/eodash:rasterform"
        },
        "eodash:vegadefinition": {
          "$ref": "#/definitions/eodash:vegadefinition"
        },
        "eodash:colorlegend": {
          "$ref": "#/definitions/eodash:colorlegend"
        },
        "eodash:flatstyle": {
          "$ref": "#/definitions/eodash:flatstyle"
        }
      },
      "patternProperties": {
        "^(?!eodash:)": {}
      },
      "additionalProperties": false
    },
    "assetAndLinkFields": {
      "$comment": "Fields allowed in Assets, Item Asset Definitions, Asset Templates, Links and Link Templates.",
      "type": "object",
      "properties": {
        "eodash:flatstyle": {
          "$ref": "#/definitions/eodash:flatstyle"
        }
      },
      "patternProperties": {
        "^(?!eodash:)": {}
      },
      "additionalProperties": false
    },
    "noFields": {
      "$comment": "Disallows all fields of this extension.",
      "type": "object",
      "patternProperties": {
        "^(?!eodash:)": {}
      },
      "additionalProperties": false
    }
  }
}
